# ─────────────────────────────────────────────
# Oráculo del Balón 2026 — Variables de entorno
# Copia este archivo como .env y llena tus credenciales
# cp .env.example .env
# ─────────────────────────────────────────────

# ── Kaggle API ────────────────────────────────
# Obtener en: https://www.kaggle.com/settings → API → Create New Token
# Descarga kaggle.json y copia los valores aquí
KAGGLE_USERNAME=tu_usuario_kaggle
KAGGLE_KEY=tu_api_key_kaggle

# ── Football-Data.org ─────────────────────────
# Registro gratuito en: https://www.football-data.org/client/register
# Plan gratuito incluye Premier League, La Liga, Bundesliga, Serie A, Ligue 1
FOOTBALL_DATA_API_TOKEN=tu_token_football_data

# ── World Bank ────────────────────────────────
# API pública — no requiere autenticación
# No necesitas configurar nada aquí